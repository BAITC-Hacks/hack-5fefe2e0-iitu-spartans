{
  "name": "voice-router",
  "private": true,
  "description": "Voice Router: гибридный голосовой AI-робот с LLM-слоем выбора сценария (HackAlem AI 2026, кейс Halyk Bank)",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm test",
    "db:migrate": "node db/migrate.ts",
    "glossary:build": "node scripts/glossary-build.ts",
    "stt:eval": "node --env-file-if-exists=.env scripts/stt-eval.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
