# Параметры окружения Voice Router. Скопировать: cp .env.example .env
# Docker Compose читает .env автоматически. Файл .env в репозиторий не попадает.

# Ключ OpenAI API для живого режима: выбор сценария моделью, распознавание речи, голос робота.
# Каждый проверяющий вписывает свой ключ; без ключа система запускается в демо-режиме.
OPENAI_API_KEY=

# Модель выбора сценария в сервисе router (backend/). Пусто — gpt-5.4-mini (выбор по docs/ROUTER_LOG.md).
ROUTER_MODEL=

# Без OPENAI_API_KEY система работает в демо-режиме автоматически (Положение §5.6.6): отдельный флаг не нужен.

# Необязательно: другой поставщик модели выбора сценария для маршрутизатора ядра — любой OpenAI-совместимый вход
# (Chat Completions). Пусто — OpenAI с OPENAI_API_KEY. Голос (распознавание и синтез) по-прежнему требует ключ OpenAI.
ROUTER_BASE_URL=
ROUTER_API_KEY=

# Необязательно: второй движок для окна «Сравнить ChatGPT и Gemini» в панели супервизора — Google Gemini через
# OpenAI-совместимый вход (generativelanguage.googleapis.com/v1beta/openai). Пусто — окно показывает, что ключ не задан.
# Сравнение не участвует в пути диалога: робот по-прежнему отвечает через сервис выбора сценария или OpenAI.
GEMINI_API_KEY=
# Модель Gemini для сравнения. Пусто — gemini-3.8-flash.
GEMINI_MODEL=

# Необязательно: модели распознавания и синтеза речи для режима звонка. Пусто — gpt-transcribe, gpt-4o-mini-tts, marin.
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# Только для запуска без Docker: строка подключения к локальному PostgreSQL 16.
# В Docker Compose строка задана в docker-compose.yml.
DATABASE_URL=postgres://voice_router:voice_router@localhost:5432/voice_router

# Только для запуска без Docker: адрес сервиса выбора сценария для web. Пусто — web выбирает сценарий сам
# (маршрутизатор ядра с ключом или демо-режим). В Docker Compose задан в docker-compose.yml.
ROUTER_URL=
