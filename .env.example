# Параметры окружения Voice Router. Скопировать: cp .env.example .env
# Docker Compose читает .env автоматически. Файл .env в репозиторий не попадает.

# Ключ OpenAI API для живого режима: распознавание речи, выбор сценария, синтез речи.
# Каркас приложения запускается и без ключа.
OPENAI_API_KEY=

# Режим работы: mock — проверка без личных ключей участников (Положение §5.6.6), live — живой режим с ключом.
# Переключение режимов добавляется вместе с маршрутизатором.
DEMO_MODE=mock

# Только для запуска без Docker: строка подключения к локальному PostgreSQL 16.
# В Docker Compose строка задана в docker-compose.yml.
DATABASE_URL=postgres://voice_router:voice_router@localhost:5432/voice_router
