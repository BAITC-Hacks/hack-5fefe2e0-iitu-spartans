      "terms": [
        "стоит",
        "ДМС"
      ]
    },
    {
      "lang": "kk",
      "text": "Өтінішім қандай күйде?",
      "scenarioId": "SC17",
      "terms": [
        "өтініш"
      ]
    },
    {
      "lang": "ru",
      "text": "Есть рассрочка на КАСКО?",
      "scenarioId": "SC31",
      "terms": [
        "КАСКО"
      ]
    },
    {
      "lang": "kk",
      "text": "КАСКО қанша тұрады?",
