      "terms": [
        "полис"
      ]
    },
    {
      "lang": "kk",
      "text": "Полисім жарамды ма?",
      "scenarioId": "SC25",
      "terms": [
        "полис"
      ]
    },
    {
      "lang": "kk",
      "text": "Жаңа көлік алдым, полис керек",
