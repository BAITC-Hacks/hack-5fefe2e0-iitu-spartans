        "продлить"
      ]
    },
    {
      "lang": "kk",
      "text": "Сақтандыру МРТ-ны өтей ме?",
      "scenarioId": "SC22",
      "terms": [
        "сақтандыру",
        "МРТ"
      ]
    },
    {
      "lang": "ru",
      "text": "Действует ли мой полис?",
